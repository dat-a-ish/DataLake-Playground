{
  "openapi": "3.0.0",
  "info": {
    "title": "My Flask API",
    "version": "1.0.0",
    "description": "A simple API for demonstration."
  },
  "servers": [
    {
      "url": "http://flask_app:5000"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Test endpoint",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/users": {
      "get": {
        "summary": "Get all users",
        "responses": {
          "200": {
            "description": "A list of users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer"
                      },
                      "name": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
